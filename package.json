{
    "name": "wgsl-linter",
    "displayName": "WGSL Linter",
    "version": "0.2.1",
    "description": "WGSL language support: semantic highlighting, diagnostics, completion, hover, navigation, rename and formatting.",
    "categories": [
        "Formatters",
        "Linters",
        "Programming Languages"
    ],
    "keywords": [
        "cli",
        "formatter",
        "intellisense",
        "linter",
        "shaders",
        "static-analysis",
        "syntax-highlighting",
        "vscode-extension",
        "webgpu",
        "wgsl"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elringus/wgsl-linter.git"
    },
    "publisher": "elringus",
    "bin": {
        "wgsl-lint": "dist/cli.js"
    },
    "files": [
        "dist/*.js",
        "dist/*.d.ts",
        "syntaxes/*.json",
        "assets/logo.png",
        "assets/file-*.svg",
        "LICENSE.md"
    ],
    "type": "module",
    "main": "./dist/vscode.js",
    "exports": {
        ".": "./dist/index.js",
        "./vscode": "./dist/vscode.js"
    },
    "scripts": {
        "lint": "vp check --fix",
        "test": "vp test",
        "cts": "bun scripts/cts.ts",
        "build": "vp pack",
        "vsce": "bun run build && vsce package --no-dependencies --out dist",
        "publish": "bun scripts/publish.ts",
        "update": "bun update -i -r --latest"
    },
    "devDependencies": {
        "@types/bun": "1.4.3",
        "@types/vscode": "1.140.0",
        "@vscode/vsce": "4.0.0",
        "vite-plus": "1.3.0",
        "webgpu": "0.6.2"
    },
    "contributes": {
        "configuration": {
            "title": "WGSL",
            "properties": {
                "wgsl.prelude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "markdownDescription": "Glob patterns of the `.wgsl` files, relative to the workspace folder, whose declarations are available to all the shaders of the folder, such as the structs and functions shared across a pipeline."
                }
            }
        },
        "languages": [
            {
                "id": "wgsl",
                "aliases": [
                    "WGSL"
                ],
                "extensions": [
                    ".wgsl"
                ],
                "configuration": "./syntaxes/language-configuration.json",
                "icon": {
                    "light": "./assets/file-light.svg",
                    "dark": "./assets/file-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "wgsl",
                "scopeName": "source.wgsl",
                "path": "./syntaxes/wgsl.tmLanguage.json"
            },
            {
                "scopeName": "inline.wgsl",
                "path": "./syntaxes/wgsl.injection.json",
                "injectTo": [
                    "source.js",
                    "source.jsx",
                    "source.js.jsx",
                    "source.ts",
                    "source.tsx"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.wgsl": "wgsl"
                }
            }
        ]
    },
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:typescript",
        "onLanguage:typescriptreact"
    ],
    "icon": "assets/logo.png",
    "engines": {
        "vscode": "^1.140.0"
    }
}
