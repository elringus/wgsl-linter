{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src", "spec", "scripts", "cts", "vite.config.ts"],
    "exclude": ["cts/suite"]
}
